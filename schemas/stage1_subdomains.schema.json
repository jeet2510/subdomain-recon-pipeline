{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Stage1SubdomainsSchema",
  "type": "object",
  "required": [
    "domain",
    "total",
    "timestamp",
    "subdomains"
  ],
  "properties": {
    "domain": {
      "type": "string"
    },
    "total": {
      "type": "integer",
      "minimum": 0
    },
    "timestamp": {
      "type": "string"
    },
    "sources_summary": {
      "type": "object",
      "additionalProperties": {
        "type": "integer"
      }
    },
    "subdomains": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "name"
        ],
        "properties": {
          "name": {
            "type": "string"
          },
          "sources": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        }
      }
    }
  }
}
