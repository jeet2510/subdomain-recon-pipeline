{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "ManifestSchema",
  "type": "object",
  "required": [
    "target_domain",
    "timestamp",
    "total_unique_subdomains",
    "stages"
  ],
  "properties": {
    "target_domain": {
      "type": "string"
    },
    "timestamp": {
      "type": "string"
    },
    "total_unique_subdomains": {
      "type": "integer",
      "minimum": 0
    },
    "execution_config": {
      "type": "object",
      "properties": {
        "concurrency": {
          "type": "integer"
        },
        "timeout": {
          "type": "number"
        },
        "screenshot_cap": {
          "type": "integer"
        }
      }
    },
    "stages": {
      "type": "object",
      "required": [
        "stage1",
        "stage2",
        "stage3"
      ],
      "properties": {
        "stage1": {
          "type": "object",
          "required": [
            "status"
          ],
          "properties": {
            "status": {
              "type": "string",
              "enum": [
                "pending",
                "running",
                "completed",
                "failed",
                "skipped"
              ]
            },
            "started_at": {
              "type": [
                "string",
                "null"
              ]
            },
            "finished_at": {
              "type": [
                "string",
                "null"
              ]
            },
            "output_file": {
              "type": [
                "string",
                "null"
              ]
            },
            "count": {
              "type": [
                "integer",
                "null"
              ]
            },
            "error": {
              "type": [
                "string",
                "null"
              ]
            }
          }
        },
        "stage2": {
          "type": "object",
          "required": [
            "status"
          ],
          "properties": {
            "status": {
              "type": "string",
              "enum": [
                "pending",
                "running",
                "completed",
                "failed",
                "skipped"
              ]
            },
            "started_at": {
              "type": [
                "string",
                "null"
              ]
            },
            "finished_at": {
              "type": [
                "string",
                "null"
              ]
            },
            "output_file": {
              "type": [
                "string",
                "null"
              ]
            },
            "total_scanned": {
              "type": [
                "integer",
                "null"
              ]
            },
            "total_200": {
              "type": [
                "integer",
                "null"
              ]
            },
            "error": {
              "type": [
                "string",
                "null"
              ]
            }
          }
        },
        "stage3": {
          "type": "object",
          "required": [
            "status"
          ],
          "properties": {
            "status": {
              "type": "string",
              "enum": [
                "pending",
                "running",
                "completed",
                "failed",
                "skipped"
              ]
            },
            "started_at": {
              "type": [
                "string",
                "null"
              ]
            },
            "finished_at": {
              "type": [
                "string",
                "null"
              ]
            },
            "output_file": {
              "type": [
                "string",
                "null"
              ]
            },
            "total_captured": {
              "type": [
                "integer",
                "null"
              ]
            },
            "error": {
              "type": [
                "string",
                "null"
              ]
            }
          }
        }
      }
    }
  }
}
